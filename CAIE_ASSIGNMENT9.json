    {
      "parameters": {
        "jsCode": "\n// Get all incoming records from Google Sheets\nconst inputItems = $input.all();\n\n// Remove empty placeholder records\nconst rows = inputItems\n  .map(item => item.json)\n  .filter(data =>\n    data &&\n    (\n      String(data.Name || \"\").trim() !== \"\" ||\n      String(data.Course || \"\").trim() !== \"\" ||\n      String(data.Status || \"\").trim() !== \"\"\n    )\n  );\n\n// Stop the workflow if no valid student records exist\nif (rows.length === 0) {\n  return [];\n}\n\n// Email subject\nconst subject = \"Data Summary from Google Sheet\";\n\n// Format each student record\nconst records = rows.map((data, index) => {\n  return `${index + 1}. Name: ${data.Name}\n   Course: ${data.Course}\n   Status: ${data.Status}`;\n});\n\n// Create the email message\nconst message = `Hi,\n\nHere is the latest data from the sheet:\n\n${records.join(\"\\n\\n\")}\n\nRegards,\nYour Automation Bot`;\n\n// Return one email containing all student records\nreturn [\n  {\n    json: {\n      subject,\n      message\n    }\n  }\n];\n"
      },
